{
	"name": "pi-desktop",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "Pi Desktop - A minimalist coding agent desktop app",
	"license": "MIT",
	"homepage": "https://github.com/gustavonline/pi-desktop",
	"repository": {
		"type": "git",
		"url": "https://github.com/gustavonline/pi-desktop.git"
	},
	"bugs": {
		"url": "https://github.com/gustavonline/pi-desktop/issues"
	},
	"scripts": {
		"dev": "vite --port 1420",
		"tauri": "tauri",
		"build:frontend": "npx vite build",
		"build": "tauri build",
		"preview": "vite preview",
		"check": "tsc --noEmit",
		"check:harness-tests": "tsc --project tsconfig.harness.json",
		"test": "npm run test:harness && npm run test:novel-domain",
		"test:harness": "node scripts/run-public-tests.mjs harness",
		"test:harness:long-horizon": "node scripts/run-public-tests.mjs long-horizon",
		"test:harness:baseline": "node scripts/run-harness-baseline.mjs",
		"test:harness:isolated": "node scripts/test-harness-isolated.mjs",
		"test:chat-layout": "node scripts/test-chat-layout.mjs",
		"test:chat-panel-resize": "node --experimental-strip-types scripts/test-chat-panel-resize.mjs",
		"test:extension-status-ui": "npm run build:frontend && node scripts/test-extension-status-ui.mjs",
		"test:context-usage-ui": "npm run build:frontend && node scripts/test-context-usage-ui.mjs",
		"test:context-entry-ui": "npm run build:frontend && node scripts/test-context-entry-ui.mjs",
		"test:context-maintenance:global": "node scripts/test-global-pi-context-maintenance.mjs",
		"test:novel-domain": "node scripts/run-public-tests.mjs regression",
		"test:novel-memory": "node --experimental-strip-types scripts/novel-memory-smoke.ts"
	},
	"dependencies": {
		"@mariozechner/mini-lit": "^0.2.0",
		"@tailwindcss/vite": "^4.1.17",
		"@tauri-apps/api": "2.11.1",
		"@tauri-apps/plugin-dialog": "2.7.2",
		"@tauri-apps/plugin-fs": "2.5.1",
		"@tauri-apps/plugin-notification": "^2.3.3",
		"@tauri-apps/plugin-shell": "^2.0.0",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/addon-webgl": "^0.19.0",
		"@xterm/xterm": "^6.0.0",
		"lit": "^3.3.1",
		"lucide": "^0.544.0",
		"pi-cursor-agent": "^0.4.2"
	},
	"devDependencies": {
		"@mariozechner/pi-coding-agent": "0.63.1",
		"@types/node": "25.5.0",
		"esbuild": "0.27.3",
		"@tauri-apps/cli": "^2.0.0",
		"typescript": "^5.7.3",
		"vite": "^7.1.6"
	}
}
